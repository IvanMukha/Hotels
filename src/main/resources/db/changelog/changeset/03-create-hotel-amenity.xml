<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create_hotel_amenity" author="Ivan_Mukha">
        <createTable tableName="hotel_amenity">
            <column name="hotel_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_hotel_amenity"
                             referencedTableName="hotel"
                             referencedColumnNames="id"/>
            </column>
            <column name="amenity_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_amenity_hotel"
                             referencedTableName="amenity"
                             referencedColumnNames="id"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>